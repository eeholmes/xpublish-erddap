include *.txt
include README.md
include pyproject.toml

graft xpublish_erddap

prune claude
prune demo
prune deploy
prune docs
prune tests
prune *.egg-info

global-exclude *.nc
global-exclude *.py[cod] __pycache__

exclude .pre-commit-config.yaml
exclude *.yml
exclude .gitignore
exclude noxfile.py
exclude .gitattributes
