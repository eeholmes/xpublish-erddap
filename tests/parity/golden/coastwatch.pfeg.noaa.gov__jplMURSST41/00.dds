Dataset {
  Float64 time[time = 8893];
  Float32 latitude[latitude = 17999];
  Float32 longitude[longitude = 36000];
  GRID {
    ARRAY:
      Float64 analysed_sst[time = 8893][latitude = 17999][longitude = 36000];
    MAPS:
      Float64 time[time = 8893];
      Float32 latitude[latitude = 17999];
      Float32 longitude[longitude = 36000];
  } analysed_sst;
  GRID {
    ARRAY:
      Float64 analysis_error[time = 8893][latitude = 17999][longitude = 36000];
    MAPS:
      Float64 time[time = 8893];
      Float32 latitude[latitude = 17999];
      Float32 longitude[longitude = 36000];
  } analysis_error;
  GRID {
    ARRAY:
      Byte mask[time = 8893][latitude = 17999][longitude = 36000];
    MAPS:
      Float64 time[time = 8893];
      Float32 latitude[latitude = 17999];
      Float32 longitude[longitude = 36000];
  } mask;
  GRID {
    ARRAY:
      Float64 sea_ice_fraction[time = 8893][latitude = 17999][longitude = 36000];
    MAPS:
      Float64 time[time = 8893];
      Float32 latitude[latitude = 17999];
      Float32 longitude[longitude = 36000];
  } sea_ice_fraction;
} jplMURSST41;
